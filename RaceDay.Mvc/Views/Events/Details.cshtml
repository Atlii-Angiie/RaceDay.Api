@model RaceDay.Mvc.Models.RaceEvent
@{ViewData["Title"]=Model.Name;}
<h1>@Model.Name</h1><p class="lead">@Model.Description</p><dl class="row"><dt class="col-sm-3">Date</dt><dd class="col-sm-9">@Model.EventDate</dd><dt class="col-sm-3">Location</dt><dd class="col-sm-9">@Model.Location</dd><dt class="col-sm-3">Distance</dt><dd class="col-sm-9">@Model.Distance km</dd><dt class="col-sm-3">Entry Fee</dt><dd class="col-sm-9">R @Model.EntryFee</dd><dt class="col-sm-3">Status</dt><dd class="col-sm-9">@Model.Status</dd></dl>
@if(Context.Session.GetString("UserRole")=="Participant"){
<a class="btn btn-primary" asp-controller="Participant" asp-action="Enrol" asp-route-id="@Model.Id">Enrol in this race</a>
}
@if(Context.Session.GetString("UserRole")=="Organiser" && Context.Session.GetInt32("UserId")==Model.OrganizerId){<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>}
<a asp-action="Index" class="btn btn-outline-secondary">Back</a>
