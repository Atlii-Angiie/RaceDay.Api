@model RaceDay.Mvc.Models.ResultInput
@{ViewData["Title"]="Record Result";}
<h1>Record Result</h1><form method="post" asp-route-id="@ViewBag.EventId">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="text-danger"></div><div class="mb-3"><label asp-for="EnrollmentId"></label><input asp-for="EnrollmentId" type="number" class="form-control" /></div><div class="mb-3"><label asp-for="FinishTime"></label><input asp-for="FinishTime" placeholder="01:12:30" class="form-control" /></div><div class="mb-3"><label asp-for="Position"></label><input asp-for="Position" type="number" class="form-control" /></div><div class="mb-3"><label asp-for="Pace"></label><input asp-for="Pace" type="number" step="0.01" class="form-control" /></div><div class="mb-3"><label asp-for="Status"></label><input asp-for="Status" class="form-control" value="Finished" /></div><button class="btn btn-primary">Save Result</button></form>
