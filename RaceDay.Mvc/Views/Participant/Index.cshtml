@model List<RaceDay.Mvc.Models.EnrolmentModel>
@{ ViewData["Title"] = "Participant Dashboard"; var confirmed = Model.Count(e => string.Equals(e.Status,"Registered",StringComparison.OrdinalIgnoreCase) || string.Equals(e.Status,"Confirmed",StringComparison.OrdinalIgnoreCase)); }
<section class="mt-4">
 <div class="rd-heading"><span class="rd-heading-icon" aria-hidden="true">👟</span><div><div class="rd-kicker">Your running journey</div><h1 class="mb-0">Participant Dashboard</h1></div></div>
 <p class="lead">Welcome, @ViewBag.Name! Ready for your next race?</p>
 @if(ViewBag.Error != null){<div class="alert alert-warning" role="alert">@ViewBag.Error</div>}
 <div class="rd-stat-grid"><div class="rd-stat rd-stat-blue"><div class="rd-stat-label">🏃 My Enrolments</div><div class="rd-stat-value">@Model.Count</div><div class="rd-stat-note">Total enrolment records</div></div><div class="rd-stat rd-stat-teal"><div class="rd-stat-label">✓ Registered Races</div><div class="rd-stat-value">@confirmed</div><div class="rd-stat-note">Registered or confirmed</div></div><div class="rd-stat rd-stat-cyan"><div class="rd-stat-label">🏅 Your Next Goal</div><div class="rd-stat-value" style="font-size:1.5rem;margin-top:12px">Keep Running!</div><div class="rd-stat-note">One finish line at a time</div></div></div>
 <div class="rd-actions"><a asp-controller="Events" asp-action="Index" class="btn btn-primary">🏁 Browse Races</a><a asp-controller="Participant" asp-action="Results" class="btn btn-outline-primary">🏆 My Results</a><a asp-controller="Participant" asp-action="Profile" class="btn btn-outline-primary">My Profile</a></div>
 <div class="rd-page-grid"><div><h2 class="rd-section-title">📋 My Enrolments</h2>
 @if(Model.Count==0){<div class="rd-panel rd-empty">No enrolments yet. <a asp-controller="Events" asp-action="Index">Find a race to join</a>.</div>}
 else{<div class="rd-table-wrap"><table class="table table-hover"><thead><tr><th>Event</th><th>Category</th><th>Status</th><th>Race Number</th><th>Action</th></tr></thead><tbody>
 @foreach(var e in Model){var statusClass = string.Equals(e.Status,"Registered",StringComparison.OrdinalIgnoreCase) || string.Equals(e.Status,"Confirmed",StringComparison.OrdinalIgnoreCase) ? "rd-status-registered" : string.Equals(e.Status,"Cancelled",StringComparison.OrdinalIgnoreCase) ? "rd-status-cancelled" : "rd-status-pending";
 <tr><td><a class="rd-table-title" asp-controller="Events" asp-action="Details" asp-route-id="@e.EventId">View event #@e.EventId</a></td><td>Category #@e.CategoryId</td><td><span class="rd-status @statusClass">@e.Status</span></td><td>@(string.IsNullOrWhiteSpace(e.RaceNumber?.ToString()) ? "—" : e.RaceNumber)</td><td><form asp-controller="Participant" asp-action="Cancel" asp-route-id="@e.Id" method="post">@Html.AntiForgeryToken()<button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Cancel this enrolment?')">Cancel</button></form></td></tr>}
 </tbody></table></div>}
 </div><aside><div class="rd-photo-card"><img src="~/images/trail-runner.jpg" alt="Runner training on a scenic mountain road"/><div class="rd-photo-copy"><div class="rd-kicker" style="color:#4be5f4">CHASE YOUR NEXT GOAL</div><h3>Your next finish line awaits.</h3><p>Discover races around you.</p><a asp-controller="Events" asp-action="Index" class="btn btn-info btn-sm mt-2">Find a Race →</a></div></div><div class="rd-panel mt-3"><h3 class="h5 fw-bold">⚡ Quick Actions</h3><div class="d-grid gap-2 mt-3"><a asp-controller="Events" asp-action="Index" class="btn btn-outline-primary text-start">🔎 Find a Race</a><a asp-controller="Participant" asp-action="Results" class="btn btn-outline-primary text-start">🏆 My Results</a><a asp-controller="Participant" asp-action="Profile" class="btn btn-outline-primary text-start">👤 My Profile</a></div></div></aside></div>
</section>
